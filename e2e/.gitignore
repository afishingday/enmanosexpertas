node_modules/
test-results/
playwright-report/
playwright/.cache/
.env

# PDFs generados por las pruebas (fuera de test-results a propósito, ver utils/paths.js)
pdfs-generados/*
!pdfs-generados/.gitkeep

# Assets reales (fotos de prueba) no se versionan: pesan mucho y son
# contenido personal. Se copian localmente desde
# C:\Users\usuario\Downloads\playwrightassets — ver README.md.
assets/reporte/*
!assets/reporte/.gitkeep
