rules_version = '2';
// ============================================================
//  EN MANOS EXPERTAS — Reglas de seguridad de Storage
//  Pegar en: Firebase Console > Storage > Reglas > Publicar
//  Fotos y PDF: solo usuarios autenticados pueden leer y escribir.
// ============================================================
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Fotos de los informes:  fotos/{informeId}/{archivo}
    match /fotos/{informeId}/{archivo} {
      allow read, write: if signedIn();
    }

    // PDF generados:  pdfs/{informeId}.pdf
    match /pdfs/{archivo} {
      allow read, write: if signedIn();
    }
  }
}
